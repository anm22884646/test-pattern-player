<Window x:Class="PatternPlayer.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="パターン出力"
        Icon="app.ico"
        Width="960" Height="540"
        MinWidth="320" MinHeight="180"
        Background="Black"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">
    <Grid Background="Black">
        <wfi:WindowsFormsHost x:Name="VideoHost" Background="Black">
            <WindowsFormsHost.Child>
                <WinForms:Panel xmlns:WinForms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
                                x:Name="VideoPanel" BackColor="Black"/>
            </WindowsFormsHost.Child>
        </wfi:WindowsFormsHost>
    </Grid>
</Window>
